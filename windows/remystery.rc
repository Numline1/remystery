#include <windows.h>
#include "resource.h"
#include "version.h"   // generated by build.ps1

IDI_APP     ICON    "remystery.ico"
IDR_SCENE   RCDATA  "..\\src\\index.html"
1           RT_MANIFEST "app.manifest"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION "ReMystery"
END

IDD_CONFIG DIALOGEX 0, 0, 230, 92
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "ReMystery Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "A high-resolution recreation of the Windows 98 ""Mystery"" screensaver.", -1, 10, 10, 210, 20
    AUTOCHECKBOX    "&Play sounds", IDC_SOUND, 10, 40, 150, 12
    DEFPUSHBUTTON   "OK", IDOK, 118, 68, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 172, 68, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
 PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ReMystery screensaver"
            VALUE "ProductName", "ReMystery"
            VALUE "FileVersion", VER_STRING
            VALUE "ProductVersion", VER_STRING
            VALUE "LegalCopyright", "MIT License. A fan recreation, not affiliated with Microsoft."
            VALUE "OriginalFilename", "ReMystery.scr"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
